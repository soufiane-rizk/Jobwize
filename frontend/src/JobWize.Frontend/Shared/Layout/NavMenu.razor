@using JobWize.Frontend.Shared.Navigation

@inject IEnumerable<INavItem> NavItems

<MudNavMenu>

    @foreach (INavItem item in NavItems.OrderBy(x => x.Order))
    {
        <AuthorizeView Roles="@item.Roles">
            <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All">
                @item.Label
            </MudNavLink>
        </AuthorizeView>
    }

</MudNavMenu>
