@using Microsoft.AspNetCore.Components
@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">

        <MudPaper Class="pa-6">

            <MudText Typo="Typo.h4" Color="Color.Error">
                Something went wrong
            </MudText>

            <MudText Class="mt-4">
                Please reload the page. If the problem continues, contact support.
            </MudText>

            <MudButton Class="mt-6"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Reload">

                Reload

            </MudButton>

        </MudPaper>

    </MudContainer>
}
