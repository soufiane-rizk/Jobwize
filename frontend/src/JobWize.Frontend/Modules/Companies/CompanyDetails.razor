@attribute [Route(CompaniesRoutes.Detail)]
@attribute [Authorize]

@using JobWize.Frontend.Modules.Applications
@using JobWize.Modules.Applications.Contracts.Public.JobApplications
@using JobWize.Modules.Companies.Contracts.Public.Companies
@using JobWize.Modules.Companies.Contracts.Public.CompanyContacts
@using GetCompanyContract = JobWize.Modules.Companies.Contracts.Public.Companies.GetCompany
@using GetCompanyContactsContract = JobWize.Modules.Companies.Contracts.Public.CompanyContacts.GetCompanyContacts

@inject CandidateCompanyService CandidateCompanyService
@inject JobApplicationService JobApplicationService
@inject IDialogService DialogService

<PageTitle>Company details</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error.Message</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_company is not null)
{
    <MudStack Spacing="3">
        <MudPaper Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">@_company.Name</MudText>

                    @if (!string.IsNullOrWhiteSpace(_company.Industry))
                    {
                        <MudText Typo="Typo.subtitle1">@_company.Industry</MudText>
                    }
                </div>

                <MudSpacer />

                @if (_company.Visibility != CompanyVisibility.Shared)
                {
                    <MudChip
                        T="string"
                        Value="@_company.Visibility.ToString()"
                        Size="Size.Small"
                        Variant="Variant.Text">
                        @_company.Visibility
                    </MudChip>
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_company.Website))
            {
                <MudLink Href="@_company.Website" Target="_blank" Class="d-block mt-3">
                    @_company.Website
                </MudLink>
            }

            @if (!string.IsNullOrWhiteSpace(_company.Description))
            {
                <MudText Class="mt-3">@_company.Description</MudText>
            }
        </MudPaper>

        <MudPaper Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Contacts</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" OnClick="AddContactAsync">Add contact</MudButton>
            </MudStack>
            @if (_contacts.Count == 0)
            {
                <MudText>No contacts have been added.</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (GetCompanyContactsContract.Item contact in _contacts)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Class="pa-3 h-100">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle1">@contact.Name</MudText>

                                    @if (contact.Visibility != CompanyContactVisibility.Shared)
                                    {
                                        <MudChip
                                            T="string"
                                            Value="@contact.Visibility.ToString()"
                                            Size="Size.Small"
                                            Variant="Variant.Text">
                                            Private
                                        </MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body2">@contact.RoleTitle</MudText>
                                @if (contact.CompanyLocationId is Guid locationId)
                                {
                                    <MudText Typo="Typo.body2">@GetLocationName(locationId)</MudText>
                                }
                                <MudText Typo="Typo.body2">@contact.Email @contact.PhoneNumber</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-3">Locations</MudText>

            @if (_company.Locations.Count == 0)
            {
                <MudText>No locations have been added.</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (GetCompanies.Location location in _company.Locations)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Class="pa-4 h-100">
                                <MudText Typo="Typo.subtitle1">@location.Label</MudText>
                                <MudText>@location.City, @location.Country</MudText>

                                @if (!string.IsNullOrWhiteSpace(location.Address))
                                {
                                    <MudText Typo="Typo.body2">@location.Address</MudText>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-3">Your applications</MudText>

            @if (_applications.Count == 0)
            {
                <MudText>You have not tracked an application for this company yet.</MudText>
            }
            else
            {
                <MudTable Items="@_applications" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Role</MudTh>
                        <MudTh>Location</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Last activity</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Role">
                            <MudLink Href="@($"/applications/{context.Id}")">
                                @(context.RoleTitle ?? "Spontaneous application")
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="Location">@(context.CompanyLocationLabel ?? "—")</MudTd>
                        <MudTd DataLabel="Status">
                            <ApplicationStatusChip Status="context.Status" />
                        </MudTd>
                        <MudTd DataLabel="Last activity">
                            @context.LastActivityAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private GetCompanyContract.Response? _company;
    private IReadOnlyList<GetJobApplications.Item> _applications = [];
    private IReadOnlyList<GetCompanyContactsContract.Item> _contacts = [];
    private Error? _error;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        Task<Result<GetCompanyContract.Response>> companyTask =
            CandidateCompanyService.GetByIdAsync(Id);
        Task<Result<GetJobApplications.Response>> applicationsTask =
            JobApplicationService.GetByCompanyAsync(Id);
        Task<Result<GetCompanyContactsContract.Response>> contactsTask =
            CandidateCompanyService.GetContactsAsync(Id);

        await Task.WhenAll(companyTask, applicationsTask, contactsTask);

        Result<GetCompanyContract.Response> companyResult = await companyTask;
        Result<GetJobApplications.Response> applicationsResult = await applicationsTask;
        Result<GetCompanyContactsContract.Response> contactsResult = await contactsTask;

        if (!companyResult.IsSuccess)
        {
            _error = companyResult.Error;
            _loading = false;
            return;
        }

        if (!applicationsResult.IsSuccess)
        {
            _error = applicationsResult.Error;
            _loading = false;
            return;
        }

        if (!contactsResult.IsSuccess)
        {
            _error = contactsResult.Error;
            _loading = false;
            return;
        }

        _company = companyResult.Value;
        _applications = applicationsResult.Value?.Applications ?? [];
        _contacts = contactsResult.Value?.Contacts ?? [];
        _loading = false;
    }

    private async Task AddContactAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(CreateCompanyContactDialog.CompanyId)] = Id,
            [nameof(CreateCompanyContactDialog.Locations)] = _company!.Locations
        };
        IDialogReference dialog = await DialogService.ShowAsync<CreateCompanyContactDialog>("Add contact", parameters);
        if ((await dialog.Result) is { Canceled: false }) await OnParametersSetAsync();
    }

    private string GetLocationName(Guid locationId)
    {
        return _company?.Locations.SingleOrDefault(location => location.Id == locationId)?.Label
            ?? "Unknown location";
    }

}
