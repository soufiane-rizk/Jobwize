@using JobWize.Modules.Companies.Contracts.Public.Companies

@inject CompanyModerationService CompanyModerationService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <LoadingIndicator Loading="@_loading">
            @if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error">@_loadError.Message</MudAlert>
            }
            else
            {
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Company information</MudText>
                    <MudTextField
                        @bind-Value="_name"
                        Label="Name"
                        Required="true"
                        Error="@(_showValidation && string.IsNullOrWhiteSpace(_name))"
                        ErrorText="Company name is required." />
                    <MudTextField @bind-Value="_website" Label="Website" />
                    <MudTextField @bind-Value="_industry" Label="Industry" />
                    <MudTextField @bind-Value="_description" Label="Description" Lines="3" />

                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Locations</MudText>
                        <MudSpacer />
                        <MudButton
                            Variant="Variant.Outlined"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="AddLocation">
                            Add location
                        </MudButton>
                    </MudStack>

                    @foreach (LocationInput location in _locations)
                    {
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2">@GetLocationTitle(location)</MudText>
                                <MudSpacer />
                                @if (location.IsNew)
                                {
                                    <MudIconButton
                                        Icon="@Icons.Material.Filled.DeleteOutline"
                                        Color="Color.Error"
                                        aria-label="Remove new location"
                                        OnClick="@(() => RemoveLocation(location))" />
                                }
                                else
                                {
                                    <MudSwitch @bind-Value="location.IsActive" Color="Color.Success">
                                        @(location.IsActive ? "Enabled" : "Disabled")
                                    </MudSwitch>
                                }
                            </MudStack>

                            <MudTextField @bind-Value="location.Label" Label="Label (optional)" />
                            <MudTextField
                                @bind-Value="location.City"
                                Label="City"
                                Required="true"
                                Error="@(_showValidation && string.IsNullOrWhiteSpace(location.City))"
                                ErrorText="City is required." />
                            <MudTextField
                                @bind-Value="location.Country"
                                Label="Country"
                                Required="true"
                                Error="@(_showValidation && string.IsNullOrWhiteSpace(location.Country))"
                                ErrorText="Country is required." />
                            <MudTextField @bind-Value="location.Address" Label="Address (optional)" />

                        </MudPaper>
                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Contacts</MudText>
                        <MudSpacer />
                        <MudButton
                            Variant="Variant.Outlined"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="AddContact">
                            Add contact
                        </MudButton>
                    </MudStack>

                    @foreach (ContactInput contact in _contacts)
                    {
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2">@(contact.IsNew ? "New shared contact" : contact.Name)</MudText>
                                <MudSpacer />
                                @if (contact.IsNew)
                                {
                                    <MudIconButton
                                        Icon="@Icons.Material.Filled.DeleteOutline"
                                        Color="Color.Error"
                                        aria-label="Remove new contact"
                                        OnClick="@(() => RemoveContact(contact))" />
                                }
                                else
                                {
                                    <MudSwitch @bind-Value="contact.IsActive" Color="Color.Success">
                                        @(contact.IsActive ? "Enabled" : "Disabled")
                                    </MudSwitch>
                                }
                            </MudStack>

                            <MudTextField
                                @bind-Value="contact.Name"
                                Label="Name"
                                Required="true"
                                Error="@(_showValidation && string.IsNullOrWhiteSpace(contact.Name))"
                                ErrorText="Name is required." />
                            <MudTextField @bind-Value="contact.RoleTitle" Label="Role (optional)" />
                            <MudTextField @bind-Value="contact.Email" Label="Email (optional)" />
                            <MudTextField @bind-Value="contact.PhoneNumber" Label="Phone (optional)" />
                            <MudSelect
                                T="int?"
                                @bind-Value="contact.LocationIndex"
                                Label="Location (optional)"
                                Clearable="true">
                                @for (int index = 0; index < _locations.Count; index++)
                                {
                                    int locationIndex = index;
                                    @if (CanSelectLocation(contact, _locations[locationIndex]))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)locationIndex)">
                                            @GetLocationTitle(_locations[locationIndex])
                                        </MudSelectItem>
                                    }
                                }
                            </MudSelect>

                        </MudPaper>
                    }
                </MudStack>
            }
        </LoadingIndicator>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="MudDialog.Cancel">Cancel</MudButton>
        <MudButton
            Color="Color.Primary"
            Disabled="@(_loading || _saving || _loadError is not null)"
            OnClick="SaveAsync">
            Save changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid CompanyId { get; set; }

    private readonly List<LocationInput> _locations = [];
    private readonly List<ContactInput> _contacts = [];
    private Error? _loadError;
    private string? _name;
    private string? _website;
    private string? _industry;
    private string? _description;
    private bool _loading = true;
    private bool _saving;
    private bool _showValidation;

    protected override async Task OnInitializedAsync()
    {
        Result<GetCompanyForManagement.Response> result =
            await CompanyModerationService.GetForManagementAsync(CompanyId);

        if (!result.IsSuccess || result.Value is null)
        {
            _loadError = result.Error;
            _loading = false;
            return;
        }

        GetCompanyForManagement.Response company = result.Value;
        _name = company.Name;
        _website = company.Website;
        _industry = company.Industry;
        _description = company.Description;

        _locations.AddRange(company.Locations.Select(location => new LocationInput
        {
            Id = location.Id,
            Label = location.Label,
            City = location.City,
            Country = location.Country,
            Address = location.Address,
            IsActive = location.IsActive
        }));

        _contacts.AddRange(company.Contacts.Select(contact => new ContactInput
        {
            Id = contact.Id,
            LocationIndex = FindLocationIndex(contact.CompanyLocationId),
            Name = contact.Name,
            RoleTitle = contact.RoleTitle,
            Email = contact.Email,
            PhoneNumber = contact.PhoneNumber,
            IsActive = contact.IsActive
        }));

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _showValidation = true;

        if (!IsValid())
        {
            return;
        }

        _saving = true;

        var request = new UpdateCompanyCatalogue.Request(
            CompanyId,
            _name!,
            _website,
            _industry,
            _description,
            _locations.Select(location => new UpdateCompanyCatalogue.Location(
                location.Id,
                location.Label,
                location.City!,
                location.Country!,
                location.Address,
                location.IsActive)).ToList(),
            _contacts.Select(contact => new UpdateCompanyCatalogue.Contact(
                contact.Id,
                contact.LocationIndex,
                contact.Name!,
                contact.RoleTitle,
                contact.Email,
                contact.PhoneNumber,
                contact.IsActive)).ToList());

        Result<bool> result = await CompanyModerationService.UpdateCatalogueAsync(request);
        _saving = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error?.Message ?? "Unable to update the company catalogue.", Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(_name) &&
               _locations.All(location =>
                   !string.IsNullOrWhiteSpace(location.City) &&
                   !string.IsNullOrWhiteSpace(location.Country)) &&
               _contacts.All(contact =>
                   !string.IsNullOrWhiteSpace(contact.Name) &&
                   IsContactLocationValid(contact));
    }

    private bool IsContactLocationValid(ContactInput contact)
    {
        if (contact.LocationIndex is null)
        {
            return true;
        }

        return contact.LocationIndex >= 0 &&
               contact.LocationIndex < _locations.Count &&
               CanSelectLocation(contact, _locations[contact.LocationIndex.Value]);
    }

    private static bool CanSelectLocation(ContactInput contact, LocationInput location)
    {
        if (!contact.IsActive)
        {
            return true;
        }

        return location.IsActive;
    }

    private void AddLocation()
    {
        _locations.Add(new LocationInput
        {
            IsActive = true
        });
    }

    private void RemoveLocation(LocationInput location)
    {
        int removedIndex = _locations.IndexOf(location);
        _locations.Remove(location);

        foreach (ContactInput contact in _contacts)
        {
            if (contact.LocationIndex == removedIndex)
            {
                contact.LocationIndex = null;
            }
            else if (contact.LocationIndex > removedIndex)
            {
                contact.LocationIndex--;
            }
        }
    }

    private void AddContact()
    {
        _contacts.Add(new ContactInput
        {
            IsActive = true
        });
    }

    private void RemoveContact(ContactInput contact)
    {
        _contacts.Remove(contact);
    }

    private int? FindLocationIndex(Guid? locationId)
    {
        if (locationId is null)
        {
            return null;
        }

        int index = _locations.FindIndex(location => location.Id == locationId);
        return index < 0 ? null : index;
    }

    private static string GetLocationTitle(LocationInput location)
    {
        if (!string.IsNullOrWhiteSpace(location.Label))
        {
            return location.Label;
        }

        if (!string.IsNullOrWhiteSpace(location.City) || !string.IsNullOrWhiteSpace(location.Country))
        {
            return $"{location.City}, {location.Country}".Trim(' ', ',');
        }

        return "New location";
    }

    private sealed class LocationInput
    {
        public Guid? Id { get; set; }
        public bool IsNew => Id is null;
        public string? Label { get; set; }
        public string? City { get; set; }
        public string? Country { get; set; }
        public string? Address { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class ContactInput
    {
        public Guid? Id { get; set; }
        public bool IsNew => Id is null;
        public int? LocationIndex { get; set; }
        public string? Name { get; set; }
        public string? RoleTitle { get; set; }
        public string? Email { get; set; }
        public string? PhoneNumber { get; set; }
        public bool IsActive { get; set; }
    }
}
