@using JobWize.Modules.Applications.Contracts.Public.JobApplications
@using ChangeStatusContract = JobWize.Modules.Applications.Contracts.Public.JobApplications.ChangeJobApplicationStatus

@inject JobApplicationService JobApplicationService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudSelect T="ApplicationStatus?" @bind-Value="_status" Label="New status" Clearable="true">
            @foreach (ApplicationStatus item in AllowedNextStatuses)
            {
                <MudSelectItem Value="item">@item</MudSelectItem>
            }
        </MudSelect>

        @if (_status == ApplicationStatus.Applied)
        {
            <MudDatePicker @bind-Date="_appliedOn" Label="Applied on" Required="true" />
        }

        <MudTextField @bind-Value="_note" Label="Timeline note" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="MudDialog.Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid ApplicationId { get; set; }

    [Parameter] public ApplicationStatus CurrentStatus { get; set; }

    [Parameter] public IReadOnlyList<ApplicationStatus> AllowedNextStatuses { get; set; } = [];

    private ApplicationStatus? _status;
    private DateTime? _appliedOn;
    private string? _note;

    protected override void OnInitialized()
    {
        _status = null;
    }

    private async Task SaveAsync()
    {
        if (_status is null)
        {
            return;
        }

        DateOnly? appliedOn = _appliedOn is null
            ? null
            : DateOnly.FromDateTime(_appliedOn.Value);

        Result<bool> result = await JobApplicationService.ChangeStatusAsync(
            new ChangeStatusContract.Request(
                ApplicationId,
                _status.Value,
                appliedOn,
                _note));

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error?.Message ?? "Unable to change status.", Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
