@attribute [Route(ApplicationsRoutes.Detail)]
@attribute [Authorize]

@using JobWize.Modules.Applications.Contracts.Public.JobApplications
@using JobWize.Modules.Applications.Contracts.Public.Interviews
@using JobWize.Modules.Applications.Contracts.Public.Reminders
@using JobWize.Frontend.Modules.Files

@inject JobApplicationService JobApplicationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CandidateDocumentService CandidateDocumentService
@inject IJSRuntime JsRuntime

<PageTitle>Application details</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error.Message</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_application is not null)
{
    <MudStack Spacing="3">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo(ApplicationsRoutes.List))">
            Applications
        </MudButton>

        <MudPaper Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <div>
                    @if (_application.CompanyId is Guid companyId)
                    {
                        <MudLink Typo="Typo.h4" Href="@($"/companies/{companyId}")">
                            @_application.CompanyName
                        </MudLink>
                    }
                    else
                    {
                        <MudText Typo="Typo.h4">@_application.CompanyName</MudText>
                    }

                    @if (!string.IsNullOrWhiteSpace(_application.CompanyLocationLabel))
                    {
                        <MudText Typo="Typo.subtitle2">@_application.CompanyLocationLabel</MudText>
                    }

                    <MudText Typo="Typo.h6">@(_application.RoleTitle ?? "Spontaneous application")</MudText>
                </div>
                <MudSpacer />
                <MudChip T="string" Value="@_application.Status.ToString()" Color="Color.Info" Variant="Variant.Text">
                    @_application.Status
                </MudChip>
            </MudStack>

            @if (_application.AppliedOn is not null)
            {
                <MudText Class="mt-3">Applied on @_application.AppliedOn.Value.ToString("dd MMMM yyyy")</MudText>
            }

            @if (!string.IsNullOrWhiteSpace(_application.Notes))
            {
                <MudText Class="mt-3">@_application.Notes</MudText>
            }
        </MudPaper>

        @if (_application.Status != ApplicationStatus.Archived)
        {
            <MudPaper Class="pa-4">
                <MudMenu Label="Actions" Variant="Variant.Filled" Color="Color.Primary">
                    <MudMenuItem OnClick="OpenNoteDialogAsync">Add note</MudMenuItem>
                    @if (_application.AllowedNextStatuses.Count > 0)
                    {
                        <MudMenuItem OnClick="OpenStatusDialogAsync">Change status</MudMenuItem>
                    }
                    @if (CanScheduleInterview(_application.Status))
                    {
                        <MudMenuItem OnClick="OpenScheduleInterviewDialogAsync">Schedule interview</MudMenuItem>
                    }
                    <MudMenuItem OnClick="OpenCvSubmissionDialogAsync">Record CV submission</MudMenuItem>
                    <MudMenuItem OnClick="OpenReminderDialogAsync">Add reminder</MudMenuItem>
                </MudMenu>
            </MudPaper>
        }

        @if (_application.Reminders.Count > 0)
        {
            <MudPaper Class="pa-6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Reminders</MudText>
                    <MudSpacer />
                    <MudButton
                        Variant="Variant.Text"
                        StartIcon="@Icons.Material.Filled.CalendarMonth"
                        Href="@ApplicationsRoutes.Agenda">
                        Open agenda
                    </MudButton>
                </MudStack>

                <MudStack Spacing="2">
                    @foreach (GetJobApplication.ReminderItem reminder in _application.Reminders)
                    {
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.subtitle1">@reminder.Title</MudText>
                                    <MudText Typo="Typo.caption">
                                        @GetReminderKindLabel(reminder.Kind) · @reminder.DueAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </MudText>
                                    @if (GetReminderRelationLabel(reminder) is string relationLabel)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block">
                                            @relationLabel
                                        </MudText>
                                    }
                                </div>
                                <MudSpacer />
                                <MudChip
                                    T="string"
                                    Value="@reminder.State.ToString()"
                                    Size="Size.Small"
                                    Color="@GetReminderStateColor(reminder.State)">
                                    @reminder.State
                                </MudChip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(reminder.Note))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@reminder.Note</MudText>
                            }

                            @if (reminder.State == ReminderState.Open)
                            {
                                <MudStack Row="true" Spacing="1" Class="mt-2">
                                    <MudButton
                                        Size="Size.Small"
                                        Color="Color.Success"
                                        Variant="Variant.Outlined"
                                        OnClick="@(() => ChangeReminderStateAsync(reminder, ReminderState.Completed))">
                                        Complete
                                    </MudButton>
                                    <MudButton
                                        Size="Size.Small"
                                        Variant="Variant.Text"
                                        OnClick="@(() => ChangeReminderStateAsync(reminder, ReminderState.Dismissed))">
                                        Dismiss
                                    </MudButton>
                                </MudStack>
                            }
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (_application.Interviews.Count > 0)
        {
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-3">Interviews</MudText>
                <MudStack Spacing="2">
                    @foreach (GetJobApplication.InterviewItem interview in _application.Interviews)
                    {
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1">@GetInterviewTypeLabel(interview.Type)</MudText>
                                <MudSpacer />
                                <MudChip
                                    T="string"
                                    Value="@interview.State.ToString()"
                                    Size="Size.Small"
                                    Color="@GetInterviewStateColor(interview.State)"
                                    Variant="Variant.Text">
                                    @interview.State
                                </MudChip>
                            </MudStack>
                            @if (interview.State == InterviewState.Scheduled && _application.Status != ApplicationStatus.Archived)
                            {
                                <MudButton
                                    Size="Size.Small"
                                    Variant="Variant.Outlined"
                                    OnClick="@(() => EditInterviewAsync(interview))">
                                    Edit
                                </MudButton>
                                <MudButton
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    Variant="Variant.Filled"
                                    OnClick="@(() => OpenInterviewResultDialogAsync(interview))">
                                    Record result
                                </MudButton>
                            }
                            <MudText Typo="Typo.body2" Class="mt-2">@interview.ScheduledAt.ToLocalTime().ToString("dddd, dd MMM yyyy · HH:mm")</MudText>
                            <MudText Typo="Typo.caption">
                                @interview.Format@(interview.DurationMinutes is null ? "" : $" · {interview.DurationMinutes} min")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(interview.Location))
                            {
                                <MudText Typo="Typo.body2">@interview.Location</MudText>
                            }
                            @if (interview.Participants.Count > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    With @string.Join(", ", interview.Participants.Select(FormatInterviewParticipant))
                                </MudText>
                            }
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (_application.CvSubmissions.Count > 0)
        {
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-3">CV submissions</MudText>
                <MudStack Spacing="2">
                    @foreach (GetJobApplication.CvSubmissionItem submission in _application.CvSubmissions)
                    {
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1">
                                    @GetSubmissionMethodLabel(submission.Method)
                                </MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.caption">
                                    @submission.SentAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </MudText>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(submission.ContactName))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">
                                    Sent to @submission.ContactName@FormatContactRole(submission.ContactRoleTitle)
                                </MudText>
                            }

                            @if (!string.IsNullOrWhiteSpace(submission.Notes))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@submission.Notes</MudText>
                            }

                            <MudStack Row="true" Spacing="1" Class="mt-2">
                                @foreach (GetJobApplication.CvSubmissionDocumentItem document in submission.Documents)
                                {
                                    <MudButton
                                        Size="Size.Small"
                                        Variant="Variant.Text"
                                        StartIcon="@Icons.Material.Filled.Download"
                                        OnClick="@(() => DownloadSubmissionDocumentAsync(document))">
                                        @document.FileName
                                    </MudButton>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-3">Activity timeline</MudText>
            <MudTimeline>
                @foreach (GetJobApplication.ActivityItem item in _application.Activities)
                {
                    <MudTimelineItem Color="@GetActivityColor(item.Type)">
                        <MudChip
                            T="string"
                            Value="@GetActivityLabel(item)"
                            Size="Size.Small"
                            Color="@GetActivityColor(item.Type)"
                            Variant="Variant.Text">
                            @GetActivityLabel(item)
                        </MudChip>
                        <MudText Typo="Typo.caption">@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</MudText>
                        @if (!string.IsNullOrWhiteSpace(item.Note))
                        {
                            <MudText>@item.Note</MudText>
                        }
                    </MudTimelineItem>
                }
            </MudTimeline>
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GetJobApplication.Response? _application;
    private Error? _error;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        Result<GetJobApplication.Response> result = await JobApplicationService.GetByIdAsync(Id);

        if (result.IsSuccess && result.Value is not null)
        {
            GetJobApplication.Response application = result.Value;
            _application = application;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private static string GetActivityLabel(GetJobApplication.ActivityItem item)
    {
        return item.Type switch
        {
            ApplicationActivityType.StatusChanged => item.Status?.ToString() ?? "Status changed",
            ApplicationActivityType.InterviewScheduled => "Interview scheduled",
            ApplicationActivityType.InterviewResultRecorded => "Interview result",
            ApplicationActivityType.CvSubmitted => "CV submitted",
            _ => "Note added"
        };
    }

    private static Color GetActivityColor(ApplicationActivityType type)
    {
        return type switch
        {
            ApplicationActivityType.StatusChanged => Color.Primary,
            ApplicationActivityType.InterviewScheduled => Color.Info,
            ApplicationActivityType.InterviewResultRecorded => Color.Success,
            ApplicationActivityType.CvSubmitted => Color.Secondary,
            _ => Color.Default
        };
    }

    private static Color GetInterviewStateColor(InterviewState state)
    {
        return state switch
        {
            InterviewState.Scheduled => Color.Info,
            InterviewState.Completed => Color.Success,
            InterviewState.Postponed => Color.Warning,
            InterviewState.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private static bool CanScheduleInterview(ApplicationStatus status)
    {
        return status is ApplicationStatus.Applied or ApplicationStatus.InProcess;
    }

    private static string GetInterviewTypeLabel(InterviewType type)
    {
        return type switch
        {
            InterviewType.RecruiterScreen => "Recruiter screen",
            InterviewType.HumanResources => "Human resources",
            InterviewType.HiringManager => "Hiring manager",
            _ => type.ToString()
        };
    }

    private async Task EditInterviewAsync(GetJobApplication.InterviewItem interview)
    {
        var parameters = new DialogParameters
        {
            [nameof(InterviewDialog.ApplicationId)] = Id,
            [nameof(InterviewDialog.CompanyId)] = _application!.CompanyId,
            [nameof(InterviewDialog.CompanyLocationId)] = _application.CompanyLocationId,
            [nameof(InterviewDialog.Interview)] = interview
        };
        IDialogReference dialog = await DialogService.ShowAsync<InterviewDialog>(
            "Edit interview",
            parameters);
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenNoteDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(NoteDialog.ApplicationId)] = Id
        };

        IDialogReference dialog = await DialogService.ShowAsync<NoteDialog>(
            "Add note",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenStatusDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(ChangeStatusDialog.ApplicationId)] = Id,
            [nameof(ChangeStatusDialog.CurrentStatus)] = _application!.Status,
            [nameof(ChangeStatusDialog.AllowedNextStatuses)] = _application.AllowedNextStatuses
        };

        IDialogReference dialog = await DialogService.ShowAsync<ChangeStatusDialog>(
            "Change status",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenScheduleInterviewDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(InterviewDialog.ApplicationId)] = Id,
            [nameof(InterviewDialog.CompanyId)] = _application!.CompanyId,
            [nameof(InterviewDialog.CompanyLocationId)] = _application.CompanyLocationId
        };

        IDialogReference dialog = await DialogService.ShowAsync<InterviewDialog>(
            "Schedule interview",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private static Color GetReminderStateColor(ReminderState state)
    {
        return state switch
        {
            ReminderState.Open => Color.Warning,
            ReminderState.Completed => Color.Success,
            ReminderState.Dismissed => Color.Default,
            _ => Color.Default
        };
    }

    private static string GetReminderKindLabel(ReminderKind kind)
    {
        return kind switch
        {
            ReminderKind.CvSubmission => "CV submission",
            ReminderKind.Interview => "Interview",
            _ => "Custom"
        };
    }

    private string? GetReminderRelationLabel(GetJobApplication.ReminderItem reminder)
    {
        if (reminder.CvSubmissionId is Guid submissionId)
        {
            GetJobApplication.CvSubmissionItem? submission = _application!.CvSubmissions
                .SingleOrDefault(item => item.Id == submissionId);

            return submission is null
                ? "Related CV submission"
                : $"CV submitted {submission.SentAt.ToLocalTime():dd MMM yyyy, HH:mm}";
        }

        if (reminder.InterviewId is Guid interviewId)
        {
            GetJobApplication.InterviewItem? interview = _application!.Interviews
                .SingleOrDefault(item => item.Id == interviewId);

            return interview is null
                ? "Related interview"
                : $"{GetInterviewTypeLabel(interview.Type)} · {interview.ScheduledAt.ToLocalTime():dd MMM yyyy, HH:mm}";
        }

        return null;
    }

    private async Task OpenCvSubmissionDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(CvSubmissionDialog.ApplicationId)] = Id,
            [nameof(CvSubmissionDialog.CompanyId)] = _application!.CompanyId,
            [nameof(CvSubmissionDialog.CompanyLocationId)] = _application.CompanyLocationId,
            [nameof(CvSubmissionDialog.Kind)] = _application.Kind
        };

        IDialogReference dialog = await DialogService.ShowAsync<CvSubmissionDialog>(
            "Record CV submission",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenReminderDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(ReminderDialog.ApplicationId)] = Id,
            [nameof(ReminderDialog.CvSubmissions)] = _application!.CvSubmissions,
            [nameof(ReminderDialog.Interviews)] = _application.Interviews
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReminderDialog>(
            "Add reminder",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task ChangeReminderStateAsync(
        GetJobApplication.ReminderItem reminder,
        ReminderState state)
    {
        Result<bool> result = await JobApplicationService.UpdateReminderStateAsync(
            new(Id, reminder.Id, state));

        if (result.IsFailure)
        {
            Snackbar.Add(result.Error?.Message ?? "Unable to update the reminder.", Severity.Error);
            return;
        }

        await LoadAsync();
    }

    private async Task DownloadSubmissionDocumentAsync(
        GetJobApplication.CvSubmissionDocumentItem document)
    {
        Result<CandidateDocumentService.DownloadedFile> result =
            await CandidateDocumentService.DownloadAsync(document.FileId);

        if (result.IsFailure || result.Value is null)
        {
            Snackbar.Add(
                result.Error?.Message ?? "The submitted document could not be downloaded.",
                Severity.Error);
            return;
        }

        await JsRuntime.InvokeVoidAsync(
            "jobWize.downloadFile",
            result.Value.FileName,
            result.Value.ContentType,
            Convert.ToBase64String(result.Value.Content));
    }

    private static string GetSubmissionMethodLabel(CvSubmissionMethod method)
    {
        return method switch
        {
            CvSubmissionMethod.JobPortal => "Submitted through a job portal",
            CvSubmissionMethod.CompanyWebsite => "Submitted through the company website",
            CvSubmissionMethod.InPerson => "Submitted in person",
            CvSubmissionMethod.Email => "Submitted by email",
            CvSubmissionMethod.Recruiter => "Submitted to a recruiter",
            _ => "CV submitted"
        };
    }

    private static string FormatContactRole(string? roleTitle)
    {
        return string.IsNullOrWhiteSpace(roleTitle)
            ? string.Empty
            : $" ({roleTitle})";
    }

    private static string FormatInterviewParticipant(
        GetJobApplication.InterviewParticipantItem participant)
    {
        string label = string.IsNullOrWhiteSpace(participant.RoleTitle)
            ? participant.Name
            : $"{participant.Name} ({participant.RoleTitle})";

        return string.IsNullOrWhiteSpace(participant.CompanyLocationLabel)
            ? label
            : $"{label} · {participant.CompanyLocationLabel}";
    }

    private async Task OpenInterviewResultDialogAsync(GetJobApplication.InterviewItem interview)
    {
        var parameters = new DialogParameters
        {
            [nameof(InterviewResultDialog.ApplicationId)] = Id,
            [nameof(InterviewResultDialog.InterviewId)] = interview.Id
        };

        IDialogReference dialog = await DialogService.ShowAsync<InterviewResultDialog>(
            "Record interview result",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }
}
