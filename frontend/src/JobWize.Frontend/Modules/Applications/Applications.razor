@attribute [Route(ApplicationsRoutes.List)]
@attribute [Authorize]

@using JobWize.Modules.Applications.Contracts.Public.JobApplications
@using JobWize.Modules.Applications.Contracts.Public.Interviews
@using JobWize.Modules.Applications.Contracts.Public.Reminders

@inject JobApplicationService JobApplicationService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Applications</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Job applications</MudText>

        <MudSpacer />

        <MudButton
            Color="Color.Primary"
            Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Add"
            OnClick="@(() => Navigation.NavigateTo(ApplicationsRoutes.Create))">
            New application
        </MudButton>
    </MudStack>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error.Message</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@_applications" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Company</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Last activity</MudTh>
                <MudTh>Last interview</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Company">
                    @if (context.CompanyId is Guid companyId)
                    {
                        <MudLink Href="@($"/companies/{companyId}")">@context.CompanyName</MudLink>
                    }
                    else
                    {
                        <MudText>@context.CompanyName</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(context.CompanyLocationLabel))
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            @context.CompanyLocationLabel
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Role">@(context.RoleTitle ?? "—")</MudTd>
                <MudTd DataLabel="Type">@(context.Kind == ApplicationKind.JobPosting ? "Job posting" : "Spontaneous CV")</MudTd>
                <MudTd DataLabel="Status">
                    <ApplicationStatusChip Status="context.Status" />
                </MudTd>
                <MudTd DataLabel="Last activity">@context.LastActivityAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Last interview">
                    @if (context.LastInterviewState is not null)
                    {
                        <MudChip
                            T="string"
                            Value="@context.LastInterviewState.ToString()"
                            Size="Size.Small"
                            Variant="Variant.Text"
                            Color="@GetInterviewStateColor(context.LastInterviewState.Value)">
                            @context.LastInterviewState
                        </MudChip>
                        <MudText Typo="Typo.caption" Class="d-block">
                            @context.LastInterviewScheduledAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                        @if (context.Status != ApplicationStatus.Archived)
                        {
                            <MudMenuItem OnClick="@(() => OpenNoteDialogAsync(context))">Add note</MudMenuItem>
                            @if (context.AllowedNextStatuses.Count > 0)
                            {
                                <MudMenuItem OnClick="@(() => OpenStatusDialogAsync(context))">Change status</MudMenuItem>
                            }
                            @if (CanScheduleInterview(context.Status) && context.LastInterviewState != InterviewState.Scheduled)
                            {
                                <MudMenuItem OnClick="@(() => OpenScheduleInterviewDialogAsync(context))">Schedule interview</MudMenuItem>
                            }
                            @if (context.LastInterviewId is not null && context.LastInterviewState == InterviewState.Scheduled)
                            {
                                <MudMenuItem OnClick="@(() => OpenInterviewResultDialogAsync(context))">
                                    Record interview result
                                </MudMenuItem>
                            }
                            <MudMenuItem OnClick="@(() => OpenCvSubmissionDialogAsync(context))">
                                Record CV submission
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => OpenReminderDialogAsync(context))">
                                Add reminder
                            </MudMenuItem>
                        }
                        <MudMenuItem Href="@($"/applications/{context.Id}")">View details</MudMenuItem>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">No applications yet. Add the first one you want to track.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<GetJobApplications.Item> _applications = [];
    private Error? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        Result<GetJobApplications.Response> result = await JobApplicationService.GetAsync();

        if (result.IsSuccess)
        {
            _applications = result.Value?.Applications ?? [];
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task OpenInterviewResultDialogAsync(GetJobApplications.Item application)
    {
        var parameters = new DialogParameters
        {
            [nameof(InterviewResultDialog.ApplicationId)] = application.Id,
            [nameof(InterviewResultDialog.InterviewId)] = application.LastInterviewId!.Value
        };

        var dialog = await DialogService.ShowAsync<InterviewResultDialog>(
            "Record interview result",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenNoteDialogAsync(GetJobApplications.Item application)
    {
        var parameters = new DialogParameters
        {
            [nameof(NoteDialog.ApplicationId)] = application.Id
        };

        IDialogReference dialog = await DialogService.ShowAsync<NoteDialog>(
            "Add note",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenStatusDialogAsync(GetJobApplications.Item application)
    {
        var parameters = new DialogParameters
        {
            [nameof(ChangeStatusDialog.ApplicationId)] = application.Id,
            [nameof(ChangeStatusDialog.CurrentStatus)] = application.Status,
            [nameof(ChangeStatusDialog.AllowedNextStatuses)] = application.AllowedNextStatuses
        };

        IDialogReference dialog = await DialogService.ShowAsync<ChangeStatusDialog>(
            "Change status",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenScheduleInterviewDialogAsync(GetJobApplications.Item application)
    {
        var parameters = new DialogParameters
        {
            [nameof(InterviewDialog.ApplicationId)] = application.Id,
            [nameof(InterviewDialog.CompanyId)] = application.CompanyId,
            [nameof(InterviewDialog.CompanyLocationId)] = application.CompanyLocationId
        };

        IDialogReference dialog = await DialogService.ShowAsync<InterviewDialog>(
            "Schedule interview",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenCvSubmissionDialogAsync(GetJobApplications.Item application)
    {
        var parameters = new DialogParameters
        {
            [nameof(CvSubmissionDialog.ApplicationId)] = application.Id,
            [nameof(CvSubmissionDialog.CompanyId)] = application.CompanyId,
            [nameof(CvSubmissionDialog.CompanyLocationId)] = application.CompanyLocationId,
            [nameof(CvSubmissionDialog.Kind)] = application.Kind
        };

        IDialogReference dialog = await DialogService.ShowAsync<CvSubmissionDialog>(
            "Record CV submission",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenReminderDialogAsync(GetJobApplications.Item application)
    {
        Result<GetJobApplication.Response> result = await JobApplicationService.GetByIdAsync(application.Id);

        if (result.IsFailure || result.Value is null)
        {
            Snackbar.Add(
                result.Error?.Message ?? "Unable to load the application for the reminder.",
                Severity.Error);
            return;
        }

        GetJobApplication.Response applicationDetails = result.Value;
        var parameters = new DialogParameters
        {
            [nameof(ReminderDialog.ApplicationId)] = applicationDetails.Id,
            [nameof(ReminderDialog.CvSubmissions)] = applicationDetails.CvSubmissions,
            [nameof(ReminderDialog.Interviews)] = applicationDetails.Interviews
        };

        IDialogReference dialog = await DialogService.ShowAsync<ReminderDialog>(
            "Add reminder",
            parameters);

        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private static Color GetInterviewStateColor(InterviewState state)
    {
        return state switch
        {
            InterviewState.Scheduled => Color.Info,
            InterviewState.Completed => Color.Success,
            InterviewState.Cancelled => Color.Error,
            InterviewState.Postponed => Color.Warning,
            _ => Color.Default
        };
    }

    private static bool CanScheduleInterview(ApplicationStatus status)
    {
        return status is ApplicationStatus.Applied or ApplicationStatus.InProcess;
    }
}
