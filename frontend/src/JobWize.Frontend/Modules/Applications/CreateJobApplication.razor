@attribute [Route(ApplicationsRoutes.Create)]
@attribute [Authorize]

@using JobWize.Modules.Applications.Contracts.Public.JobApplications
@using CreateJobApplicationContract = JobWize.Modules.Applications.Contracts.Public.JobApplications.CreateJobApplication
@using GetSelectableCompaniesContract = JobWize.Modules.Applications.Contracts.Public.Companies.GetSelectableCompanies
@using JobWize.Frontend.Modules.Companies

@inject JobApplicationService JobApplicationService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>New application</PageTitle>

<MudPaper MaxWidth="MaxWidth.Medium" Class="pa-6 mx-auto mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Track an application</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudAutocomplete
                    T="Guid?"
                    @bind-Value="_companyId"
                    @bind-Value:after="OnCompanyChanged"
                    @bind-Text="_companySearch"
                    Label="Company"
                    Required="true"
                    Error="@(_showValidation && _companyId is null)"
                    ErrorText="Company is required."
                    Clearable="true"
                    SearchFunc="SearchCompaniesAsync"
                    ToStringFunc="GetCompanyName"
                    CoerceText="false">
                <NoItemsTemplate>
                    <MudStack Spacing="1" Class="pa-2">
                        <MudText Typo="Typo.body2">No companies found.</MudText>
                        <MudText Typo="Typo.caption">
                            Add a private company to use it in this application.
                        </MudText>
                        <MudButton
                            Color="Color.Primary"
                            Variant="Variant.Text"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="CreatePrivateCompanyAsync">
                            Add company
                        </MudButton>
                    </MudStack>
                </NoItemsTemplate>
            </MudAutocomplete>
        </MudItem>

        @if (SelectedCompany is not null && SelectedCompany.Locations.Count > 0)
        {
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="_companyLocationId" Label="Location (optional)" Clearable="true">
                    @foreach (GetSelectableCompaniesContract.Location location in SelectedCompany.Locations)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">
                            @location.Label
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_roleTitle" Label="Role / position" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="ApplicationKind" @bind-Value="_kind" Label="Application type">
                <MudSelectItem Value="ApplicationKind.JobPosting">Specific job posting</MudSelectItem>
                <MudSelectItem Value="ApplicationKind.SpontaneousApplication">Spontaneous CV</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect
                T="ApplicationStatus"
                @bind-Value="_status"
                @bind-Value:after="UpdateAppliedOn"
                Label="Current status">
                @foreach (ApplicationStatus status in Enum.GetValues<ApplicationStatus>())
                {
                    <MudSelectItem Value="status">@GetStatusLabel(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @if (RequiresAppliedOn(_status))
        {
            <MudItem xs="12" md="4">
                <MudDatePicker
                    @bind-Date="_appliedOn"
                    Label="Applied on"
                    Required="true"
                    Error="@(_showValidation && RequiresAppliedOn(_status) && _appliedOn is null)"
                    ErrorText="Applied on is required when the application has been sent." />
            </MudItem>
        }

        <MudItem xs="12">
            <MudTextField @bind-Value="_sourceUrl" Label="Offer URL (optional)" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_notes" Label="Notes (optional)" Lines="3" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton OnClick="@(() => Navigation.NavigateTo(ApplicationsRoutes.List))">
            Cancel
        </MudButton>

        <MudButton
            Color="Color.Primary"
            Variant="Variant.Filled"
            Disabled="@_saving"
            OnClick="CreateAsync">
            Save application
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private bool _saving;
    private bool _showValidation;
    private IReadOnlyList<GetSelectableCompaniesContract.Item> _companies = [];
    private Guid? _companyId;
    private Guid? _companyLocationId;
    private string? _companySearch;
    private string? _roleTitle;
    private string? _sourceUrl;
    private string? _notes;
    private ApplicationKind _kind = ApplicationKind.JobPosting;
    private ApplicationStatus _status = ApplicationStatus.Planned;
    private DateTime? _appliedOn;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompaniesAsync();
    }

    private GetSelectableCompaniesContract.Item? SelectedCompany =>
        _companies.SingleOrDefault(company => company.Id == _companyId);

    private async Task CreateAsync()
    {
        _showValidation = true;

        if (_companyId is null)
        {
            return;
        }

        if (RequiresAppliedOn(_status) && _appliedOn is null)
        {
            return;
        }

        _saving = true;

        Result<CreateJobApplicationContract.Response> result = await JobApplicationService.CreateAsync(
            new(
                _companyId.Value,
                _companyLocationId,
                _roleTitle,
                _kind,
                _status,
                _appliedOn is null ? null : DateOnly.FromDateTime(_appliedOn.Value),
                _sourceUrl,
                _notes));

        _saving = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error?.Message ?? "Unable to save the application.", Severity.Error);
            return;
        }

        Snackbar.Add("Application saved.", Severity.Success);

        Navigation.NavigateTo(ApplicationsRoutes.List, replace: true);
    }

    private async Task CreatePrivateCompanyAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(CreatePrivateCompanyDialog.InitialName)] = _companySearch
        };

        IDialogReference dialog = await DialogService.ShowAsync<CreatePrivateCompanyDialog>(
            "Add private company",
            parameters);

        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not Guid companyId)
        {
            return;
        }

        await LoadCompaniesAsync();

        _companyId = companyId;
        _companyLocationId = null;
        _companySearch = GetCompanyName(companyId);
    }

    private async Task LoadCompaniesAsync()
    {
        Result<GetSelectableCompaniesContract.Response> result =
            await JobApplicationService.GetSelectableCompaniesAsync();

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error?.Message ?? "Unable to load companies.", Severity.Error);
            _companies = [];
            return;
        }

        _companies = result.Value?.Companies ?? [];
    }

    private void OnCompanyChanged()
    {
        _companyLocationId = null;
    }

    private Task<IEnumerable<Guid?>> SearchCompaniesAsync(
        string? searchText,
        CancellationToken cancellationToken)
    {
        _companySearch = searchText;

        IEnumerable<Guid?> companyIds = _companies
            .Where(company =>
                string.IsNullOrWhiteSpace(searchText) ||
                company.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Select(company => (Guid?)company.Id);

        return Task.FromResult(companyIds);
    }

    private string GetCompanyName(Guid? companyId)
    {
        return _companies
            .SingleOrDefault(company => company.Id == companyId)
            ?.Name
            ?? string.Empty;
    }

    private void UpdateAppliedOn()
    {
        _appliedOn = RequiresAppliedOn(_status)
            ? _appliedOn ?? DateTime.Today
            : null;
    }

    private static bool RequiresAppliedOn(ApplicationStatus status)
    {
        return status is not ApplicationStatus.Draft and not ApplicationStatus.Planned;
    }

    private static string GetStatusLabel(ApplicationStatus status)
    {
        return status == ApplicationStatus.Applied ? "Applied / CV sent" : status.ToString();
    }
}
