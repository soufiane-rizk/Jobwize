@attribute [Route(IdentityRoutes.ChangePassword)]
@attribute [Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using JobWize.Frontend.Modules.Dashboard
@using JobWize.Frontend.Modules.Identity.Authentication
@using JobWize.Frontend.Shared.Forms
@using JobWize.Modules.Identity.Contracts.Public.Authentication

@inherits ResultFormComponentBase<AuthenticationResponse>

@inject AuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@layout Shared.Layout.AuthenticationLayout

<PageTitle>Change password</PageTitle>

<LoadingIndicator Loading="!_initialized">
    <MudPaper Elevation="8" Class="pa-8" Style="width: min(100%, 28rem);">
        <MudStack Spacing="3">
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Style="color: white;"><MudIcon Icon="@Icons.Material.Filled.LockReset" /></MudAvatar>
                <MudText Typo="Typo.h4" Align="Align.Center">Change your password</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">For security, choose a new password before continuing.</MudText>
            </MudStack>

            @if (SubmissionResult?.IsFailure == true && SubmissionResult.Error?.ValidationErrors is null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@SubmissionResult.Error!.Message</MudAlert>
            }

            <MudForm @key="SubmissionVersion" @ref="_form">
                <MudTextField @bind-Value="_model.CurrentPassword" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth="true" Immediate="true" Validation="@(new Func<string, IEnumerable<string>>(ValidateCurrentPassword))" />
                <MudTextField @bind-Value="_model.NewPassword" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth="true" Immediate="true" Validation="@(new Func<string, IEnumerable<string>>(ValidateNewPassword))" />
                <MudTextField @bind-Value="_model.ConfirmPassword" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth="true" Immediate="true" Validation="@(new Func<string, IEnumerable<string>>(ValidateConfirmPassword))" />
            </MudForm>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="IsSubmitting" OnClick="ChangePasswordAsync">
                @if (IsSubmitting) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" /> }
                Update password
            </MudButton>
        </MudStack>
    </MudPaper>
</LoadingIndicator>

@code {
    private readonly ChangePasswordModel _model = new();
    private MudForm? _form;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo(IdentityRoutes.Login, replace: true);
            return;
        }

        if (state.User.FindFirst(AuthenticationClaimTypes.MustChangePassword)?.Value != "true")
        {
            Navigation.NavigateTo(DashboardRoutes.Home, replace: true);
            return;
        }

        _initialized = true;
    }

    private async Task ChangePasswordAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;

        IsSubmitting = true;
        try
        {
            var result = await AuthenticationService.ChangePasswordAsync(
                new JobWize.Modules.Identity.Contracts.Public.Authentication.ChangePassword.Request(_model.CurrentPassword, _model.NewPassword, _model.ConfirmPassword));

            SetSubmissionResult(result);
            if (result.IsSuccess) Navigation.NavigateTo(DashboardRoutes.Home, replace: true);
        }
        finally { IsSubmitting = false; }
    }

    private static IEnumerable<string> ValidateCurrentPassword(string value) => string.IsNullOrWhiteSpace(value) ? ["Current password is required."] : [];
    private static IEnumerable<string> ValidateNewPassword(string value) => string.IsNullOrWhiteSpace(value) ? ["New password is required."] : value.Length < 8 ? ["Password must contain at least 8 characters."] : [];
    private IEnumerable<string> ValidateConfirmPassword(string value) => string.IsNullOrWhiteSpace(value) ? ["Confirm your new password."] : value != _model.NewPassword ? ["Passwords do not match."] : [];

    private sealed class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
